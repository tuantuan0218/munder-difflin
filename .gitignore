node_modules/
node_modules
out/
dist/
.DS_Store
*.log
.vite/
.env
.env.local
.env.signing
.gstack/

# signing / notarization secrets — NEVER commit these
*.p8
*.p12
*.cer
*.mobileprovision
build/AuthKey_*.p8

# heavy hero source — only the compressed hero.mp4/.webm are deployed
docs/media/*.mov

# git worktree mounts for hive worker agents — never commit (each is a separate branch checkout)
# NOTE: real dir is worktrees/ (no dot); the old .worktrees/ pattern never matched
worktrees/

# raw demo screen recordings — only the compressed docs/media/demo/*.mp4 are deployed
docs/media/MunderDifflin*.mp4

# blog theme previews (local only)
docs/blog-preview-*/

# Munder Difflin hive runtime state - never commit (harness-managed, single-writer)
agents/
hive/
harness/
palace/
roster-backups/
roster*.json
roster.json*
app-args.json
app-env.json
hallways.json

# local caches and scratch (regenerable)
.electron-cache/
.npm-cache/
.qwen/
.userdata/
.tmp/
.claude/

# tunnel artifacts (recreated on next tunnel start)
tunnel*.log
tunnel*.err
